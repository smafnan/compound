# Cloud sync (optional). Create a free project at https://supabase.com,
# run the files in supabase/migrations/ (in name order) in its SQL editor,
# apply the dashboard settings in docs/security.md, then copy these two values
# from Project Settings → API into a file named `.env` and rebuild.
# Without them the app runs in local-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
